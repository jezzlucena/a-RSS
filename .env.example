# Monorepo env reference. NOT loaded at runtime by any app.
# Each app/runtime reads its own dotenv file:
#
#   apps/api/.env       — read by dotenv/config in src/config/env.ts (cwd = apps/api)
#   apps/web/.env       — read by Vite at build time (only VITE_* vars exposed to browser)
#   packages/shared/    — pure library, no env needed
#   ios/                — uses Xcode build settings (project.yml), not dotenv
#
# Use `apps/api/.env.example` and `apps/web/.env.example` as the source of truth for each
# app. This file mirrors them in one place for quick reference.

# ════════════════════════════════════════════════════════════════════════════════
# apps/api  →  copy into apps/api/.env
# ════════════════════════════════════════════════════════════════════════════════

NODE_ENV=development
API_PORT=4000

# Mongo (matches docker-compose.yml port mapping)
MONGO_URL=mongodb://localhost:27017/arss

# Auth — `openssl rand -hex 64` for production
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Magic-link email delivery (optional in dev — prints link to stdout if SMTP_URL is empty)
SMTP_URL=
MAIL_FROM=a-RSS <noreply@a-rss.app>

# Google Sign-In (server-side ID-token verification). Optional.
GOOGLE_OAUTH_CLIENT_ID=

# Apple Sign-In: audience = your iOS bundle ID. Optional.
APPLE_CLIENT_ID=com.arss.app

# Anthropic — required for the process-entry pipeline (Claude Haiku 4.5)
ANTHROPIC_API_KEY=
SUMMARIZER_MODEL=claude-haiku-4-5-20251001

# S3-compatible image cache (MinIO in dev). Leave S3_ENDPOINT empty for real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=arss-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Paywall fetcher: comma-separated strategy chain
# Available strategies: ladder, googlebot, wayback, archive_ph, none
PAYWALL_STRATEGIES=ladder,googlebot,wayback,archive_ph

# Base URL of a self-hosted Ladder instance (https://github.com/everywall/ladder)
LADDER_URL=http://localhost:8080

CORS_ALLOWLIST=http://localhost:5173
WEB_BASE_URL=http://localhost:5173
IOS_UNIVERSAL_LINK_HOST=a-rss.app

# ════════════════════════════════════════════════════════════════════════════════
# apps/web  →  copy into apps/web/.env
# ════════════════════════════════════════════════════════════════════════════════

# Google Sign-In OAuth client ID (Web client). Surfaced to the browser.
VITE_GOOGLE_CLIENT_ID=

# Override only when serving the web from a different origin than the api in production.
# VITE_API_BASE_URL=

# ════════════════════════════════════════════════════════════════════════════════
# ios/  →  set in Xcode build settings (project.yml top-level `settings.base`)
# ════════════════════════════════════════════════════════════════════════════════
#
#   ARSS_API_BASE_URL          — apex base URL the iOS APIClient hits
#   GOOGLE_CLIENT_ID           — GoogleSignIn-iOS client ID
#   GOOGLE_REVERSED_CLIENT_ID  — reverse-DNS form for the URL scheme entry
#
# (No iOS .env file — Xcode injects these at build time and they land in Info.plist.)

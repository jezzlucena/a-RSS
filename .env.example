# Consolidated env for `docker compose up`. Loaded by the dev service (api + web).
# Copy this file to `.env` at the repo root and fill in the placeholders below.
# `.env` is gitignored — never commit real secrets.

# --- Runtime ---
NODE_ENV=development
API_PORT=4000

# --- MongoDB (docker service name + custom port; see docker-compose.yml) ---
MONGO_URL=mongodb://localhost:27020/arss

# --- JWT / refresh cookie ---
# Required, 16+ chars each. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-hex-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-char-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Email (magic-link delivery) ---
# Optional — without it, magic-link sign-in requests will fail to send but
# password-based signup/login still works.
SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM=a-RSS <noreply@a-rss.com>

# --- LLM / summarizer ---
# There is no server-wide LLM API key. Each account picks a provider (Anthropic, OpenAI,
# Gemini, DeepSeek, Qwen, Kimi, or any OpenAI-compatible endpoint) in Settings and stores
# its own keys, encrypted at rest with USER_SECRETS_KEY below. This is only the default
# Anthropic model; other providers' defaults live in packages/shared/src/llm.ts and every
# model is overridable per account.
# Running a local OpenAI-compatible server (Ollama, LM Studio)? The system prompt plus a
# 12,000-char article needs a context window of at least 8192 tokens (Ollama:
# OLLAMA_CONTEXT_LENGTH=8192), or the model sees a truncated prompt and answers garbage.
SUMMARIZER_MODEL=claude-haiku-4-5

# --- Encryption key for user-supplied secrets (per-user LLM API keys) ---
# Required, 32+ chars. Generate with: openssl rand -hex 32
# Rotating this invalidates every secret already stored.
USER_SECRETS_KEY=change-me-to-a-random-32-plus-char-secret

# --- S3-compatible image cache ---
# Defaults below match the docker-compose `minio` service out of the box.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=arss-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Paywall ---
PAYWALL_STRATEGIES=ladder,googlebot,wayback,archive_ph
LADDER_URL=http://localhost:8190

# --- CORS / public URLs ---
CORS_ALLOWLIST=http://localhost:8088,http://localhost:5173
WEB_BASE_URL=http://localhost:5173
IOS_UNIVERSAL_LINK_HOST=a-rss.app

# --- Sign-in providers ---
# Optional — omit to disable Google/Apple sign-in (email/password still works).
# Create a Google OAuth client at https://console.cloud.google.com/apis/credentials
# Comma-separated allowlist of OAuth client ids whose ID tokens the API accepts. Google issues
# tokens with the audience of the client that requested them, so list the *Web* client (used
# by the web app) AND the *iOS* client (used by the app, set as GOOGLE_CLIENT_ID in
# ios/Local.xcconfig). Only Web clients have a secret; iOS clients don't.
GOOGLE_OAUTH_CLIENT_ID=your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
APPLE_CLIENT_ID=com.example.app

# --- Web (Vite). Only VITE_* vars are exposed to the browser. ---
# The *Web* client id (must be one of the ids in GOOGLE_OAUTH_CLIENT_ID above).
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

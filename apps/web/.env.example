# Web client env. Copy to apps/web/.env (gitignored) and fill in.
# Loaded by Vite at build time. Only VITE_*-prefixed vars are exposed to the browser.
# https://vitejs.dev/guide/env-and-mode.html

# --- Google Sign-In (Identity Services / GIS button) ---
# Find this in the Google Cloud Console → OAuth 2.0 Client IDs (Web client).
# When empty, the "Continue with Google" button hides itself with a help message.
VITE_GOOGLE_CLIENT_ID=

# --- API base URL ---
# Default ('') uses Vite's dev proxy at /api → http://localhost:4000 (see vite.config.ts).
# Override in production to an absolute https://api.example.com URL if you serve the web
# app from a different origin than the api.
# VITE_API_BASE_URL=

# --- Runtime ---
NODE_ENV=development
API_PORT=4000

# --- MongoDB (matches docker-compose.yml) ---
MONGO_URL=mongodb://localhost:27017/arss

# --- JWT / refresh cookie ---
# Generate strong random values for production: `openssl rand -hex 64`
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Email (magic-link delivery) ---
# Optional in dev: when SMTP_URL is unset, the magic-link URL is logged to stdout.
SMTP_URL=
MAIL_FROM=a-RSS <noreply@a-rss.app>

# --- Google Sign-In (verifies ID tokens from web + iOS clients) ---
# Optional. When unset, /auth/google returns 503.
GOOGLE_OAUTH_CLIENT_ID=

# --- Apple Sign-In (audience = your iOS app's bundle ID) ---
# Optional. When unset, /auth/apple returns 503.
APPLE_CLIENT_ID=com.arss.app

# --- Anthropic / summarizer ---
# API keys are configured per-user via Settings (encrypted at rest with USER_SECRETS_KEY).
# The model below is the default for every user's summarization call.
SUMMARIZER_MODEL=claude-haiku-4-5-20251001

# --- Encryption key for user-supplied secrets (e.g. Anthropic API keys) ---
# 32 bytes encoded as hex (64 chars) or base64 (44 chars w/ padding).
# Generate: `openssl rand -hex 32`. Rotating this invalidates every stored secret.
USER_SECRETS_KEY=

# --- S3-compatible image cache (MinIO in dev) ---
# In dev, set all four to use docker-compose's MinIO. In production, point at real S3
# and leave S3_ENDPOINT empty.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=arss-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Paywall bypass strategy chain (comma-separated, in order) ---
# Per-source overrides live on the Source document.
PAYWALL_STRATEGIES=ladder,googlebot,wayback,archive_ph

# --- CORS allowlist (comma-separated origins for the web client) ---
CORS_ALLOWLIST=http://localhost:5173

# --- Public URLs (used in emails + iOS universal links) ---
WEB_BASE_URL=http://localhost:5173
IOS_UNIVERSAL_LINK_HOST=a-rss.app
